# ===========================================
# CARTBACK API — Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# Server
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Supabase (get from Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Redis (Railway provides this, or use local)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Meta WhatsApp Cloud API
WA_ACCESS_TOKEN=your-meta-whatsapp-access-token
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_BUSINESS_ACCOUNT_ID=your-waba-id
WA_VERIFY_TOKEN=your-webhook-verify-token
WA_APP_SECRET=your-meta-app-secret

# Shopify (for OAuth flow — fill when building Shopify integration)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_checkouts,read_customers

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sentry (optional but recommended)
SENTRY_DSN=
